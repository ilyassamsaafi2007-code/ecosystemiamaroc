# Copy to .env and set real values; never commit .env
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0

# --- Administration : emails (séparés par des virgules) autorisés à valider les profils (carte nationale + selfie).
# Il faut que l'email soit vérifié pour que le rôle admin s'applique.
ADMIN_EMAILS=ton.email@gmail.com

# --- Envoi du code de vérification de l'email (SMTP).
# Avec Gmail : activer la validation en 2 étapes, créer un "mot de passe d'application" (16 caractères)
# https://myaccount.google.com/apppasswords  puis le mettre dans SMTP_PASSWORD.
# Sans SMTP, le code s'affiche dans le terminal (mode développement uniquement).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=ton.email@gmail.com

OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_BASE_URL=https://replace-with-your-omniroute-compatible-api-base-url
OMNIROUTE_MODEL=your-supported-model-id
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Captcha Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile).
# Laisser vide = captcha désactivé. Clés de test : 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Base de données Supabase (OBLIGATOIRE sur Vercel : comptes, commentaires, candidatures, photos CIN).
# Supabase -> Project Settings -> API Keys : "Project URL" + clé SECRÈTE (sb_secret_...) ou, sur un ancien projet, service_role.
# Cette clé donne tous les droits : jamais dans GitHub, jamais dans le navigateur.
# Sans ces deux variables, l'app utilise des fichiers locaux dans DATA_DIR (développement local seulement).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
# DATA_DIR=/chemin/disque/permanent     # (hébergement avec disque seulement, sans Supabase)
